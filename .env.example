# Copy to .env.local (never commit real values). All NEXT_PUBLIC_* values are baked into the
# browser bundle at build time, so only put public values here.

# Developer tools in the URL: ?debug=1, ?simulate=gate1, ?perf=1, ?shots, ?reviews=memory, ?topo=off, ?edge=off.
# On unless set to 0. Set NEXT_PUBLIC_DEV_TOOLS=0 in production once field testing is over.
NEXT_PUBLIC_DEV_TOOLS=1

# Public site URL for metadata, robots and sitemap (optional; defaults to https://nust-world.vercel.app).
# Leave these two commented out unless you set a value: an empty value replaces the default.
# NEXT_PUBLIC_SITE_URL=
# Where the "Feedback" link points (optional; defaults to the author's LinkedIn).
# NEXT_PUBLIC_FEEDBACK_URL=

# Email address that "Report a mistake" opens a draft to (optional).
NEXT_PUBLIC_REPORT_EMAIL=

# Reviews and food ratings (docs/REVIEWS_SETUP.md). Off unless set to 1.
NEXT_PUBLIC_REVIEWS_ENABLED=0
# Supabase project URL and its *anon* (public) key. Never put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated email domains allowed to post. Must match the allowed_domains table.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=nust.edu.pk,seecs.edu.pk
